# Copy to `.env` and fill in.
#
# Comma-separated Firebase Auth UIDs allowed to manage blog posts at /blog/admin.
# Get your UID from Firebase Console -> Authentication -> Users, or from the
# /blog/admin page after signing in. The same UID must be allowed in the
# Firestore security rules for the `posts` collection.
#
# On the server this same file (next to docker-compose.yml) feeds the Docker
# build arg, so create it there before the first `docker compose up --build`.
VITE_ADMIN_UIDS=
